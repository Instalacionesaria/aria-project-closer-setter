{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/webhooks/ghl.ts": { "maxDuration": 60 },
    "api/closer/analizar.ts": { "maxDuration": 60 },
    "api/closer/citas-respaldo.ts": { "maxDuration": 300 },
    "api/closer/sincronizar.ts": { "maxDuration": 60 },
    "api/closer/tick.ts": { "maxDuration": 15 }
  },
  "crons": [
    { "path": "/api/closer/citas-respaldo", "schedule": "25,55 * * * *" }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
