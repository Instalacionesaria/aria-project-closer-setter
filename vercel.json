{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/webhooks/ghl.ts": {
      "maxDuration": 60
    },
    "api/webhooks/llamada.ts": {
      "maxDuration": 300
    },
    "api/closer/analizar.ts": {
      "maxDuration": 60
    },
    "api/closer/citas-respaldo.ts": {
      "maxDuration": 300
    },
    "api/closer/sincronizar.ts": {
      "maxDuration": 60
    },
    "api/closer/tick.ts": {
      "maxDuration": 15
    },
    "api/meta-respaldo.ts": {
      "maxDuration": 300
    },
    "api/auditor-amarillo.ts": {
      "maxDuration": 300
    },
    "api/voz-respaldo.ts": {
      "maxDuration": 300
    },
    "api/territorio-respaldo.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/closer/citas-respaldo",
      "schedule": "25,55 * * * *"
    },
    {
      "path": "/api/voz-respaldo",
      "schedule": "35 */2 * * *"
    },
    {
      "path": "/api/meta-respaldo",
      "schedule": "20 6 * * *"
    },
    {
      "path": "/api/auditor-amarillo",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/territorio-respaldo",
      "schedule": "10 */2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
