# Plantilla de variables de entorno. Copiar a `.env.local` (gitignoreado) y completar.
# NINGUNA clave real va en este archivo — es la única variante de `.env*` que se versiona.

# ─────────────────────────────────────────────────────────────────────────────
# Frontend (expuestas al browser — prefijo VITE_ obligatorio)
# ─────────────────────────────────────────────────────────────────────────────

# Fuente de datos de la sección Seguimientos.
#   (sin definir) → `seed`: demo en memoria, sin red. Es el default y lo que corre
#                   en un clone limpio, así que la demo nunca se rompe por falta de config.
#   mock          → repositorio en el browser: ejercita TODO el camino async
#                   (hidratación, StrictMode, POST) sin servidor ni credenciales.
#   /api          → funciones reales de este repo.
VITE_SEGUIMIENTOS_API=

# ─────────────────────────────────────────────────────────────────────────────
# Backend (solo server-side — NUNCA con prefijo VITE_, no deben llegar al browser)
# ─────────────────────────────────────────────────────────────────────────────

# Supabase SOFIA. Opción A (CLI, permite aplicar migraciones):
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# Opción B (solo conexión desde las funciones):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# GoHighLevel. `GHL_MODO=real` activa el adapter real; cualquier otro valor
# (o vacío) deja el stub, que registra la intención en el outbox sin llamar a GHL.
GHL_MODO=stub
GHL_API_KEY=
GHL_LOCATION_ID=
